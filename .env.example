# Supabase → Connect → Session pooler (порт 5432). Нужен и приложению, и миграциям.
DATABASE_URL=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres

# Claude API — только на сервере.
ANTHROPIC_API_KEY=
# Модели генерации и проверки заданий; по умолчанию claude-sonnet-5-5.
CLAUDE_MODEL_GENERATE=
CLAUDE_MODEL_GRADE=

# Langfuse Cloud — трейсы вызовов Claude. Без ключей трейсинг выключен, приложение работает как раньше.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Регион проекта: https://cloud.langfuse.com (EU) или https://us.cloud.langfuse.com (US).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
