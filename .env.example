# Supabase → Connect → Session pooler (порт 5432). Нужен и приложению, и миграциям.
DATABASE_URL=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres

# Claude API — только на сервере.
ANTHROPIC_API_KEY=
# Модели генерации и проверки заданий; по умолчанию claude-sonnet-5-5.
CLAUDE_MODEL_GENERATE=
CLAUDE_MODEL_GRADE=
